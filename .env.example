OPENAI_API_KEY=
# Set both model ids explicitly; check the current OpenAI model list rather than guessing.
LLM_STRONG=                 # a current OpenAI flagship model id
LLM_CHEAP=                  # a current small OpenAI model id
EMBEDDING_MODEL=text-embedding-3-small
FIRECRAWL_API_KEY=
SEARCH_BACKEND=firecrawl
OFFLINE_MODE=false
MAX_COMPETITORS=6
STALE_AFTER_DAYS=365
MAX_TOOL_CALLS_PER_AGENT=20
AGENT_TIMEOUT_S=180
MAX_PAGES_SCRAPED_PER_AGENT=25

# Additions (src/agent/config.py)
KNOWLEDGE_BACKEND=real      # real = injected src.knowledge service; fake = separate test backend
DATA_DIR=data
FEEDBACK_MAX_ITEMS=5000
LLM_CONCURRENCY=8

# Private PostgreSQL URL; use an ignored .env and never commit a real value.
# Python feedback reads use this only after explicit service injection or the inspection command.
DATABASE_URL=
