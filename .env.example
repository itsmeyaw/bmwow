# Copy to .env at the repository root. Never commit real values.

# Private Neon Postgres URL: TypeScript server, scripts/preprocess.ts, and Python feedback
# reads (only after explicit service injection or the inspection command).
DATABASE_URL=

OPENAI_API_KEY=
# Set both model ids explicitly; check the current OpenAI model list rather than guessing.
# LLM_STRONG also drives the analysis chat (/api/chat).
LLM_STRONG=                 # a current OpenAI flagship model id
LLM_CHEAP=                  # a current small OpenAI model id
EMBEDDING_MODEL=text-embedding-3-small
FIRECRAWL_API_KEY=
SEARCH_BACKEND=firecrawl
OFFLINE_MODE=false
MAX_COMPETITORS=6
STALE_AFTER_DAYS=365
MAX_TOOL_CALLS_PER_AGENT=20
AGENT_TIMEOUT_S=180
MAX_PAGES_SCRAPED_PER_AGENT=25

# Python reference agents (python/bmwow/agent/config.py)
KNOWLEDGE_BACKEND=real      # real = bmwow.agent.knowledge_bridge, fake = python/tests/fakes
# DATA_DIR=                 # default: <repo>/data
FEEDBACK_MAX_ITEMS=5000
LLM_CONCURRENCY=8
ALLOW_LLM_ON_INTERNAL_DATA=false  # true sends BMW feedback text to the LLM (sub-themes, structure judgment); keep false until cleared
